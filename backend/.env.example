# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# Database — SQLite for local dev (zero infra). For Postgres production use:
# DATABASE_URL=postgresql://frontdesk:frontdesk@localhost:5432/frontdesk?schema=public
DATABASE_URL=file:./dev.db
# Auth
JWT_SECRET=dev_jwt_secret_change_in_production_32chars_min
JWT_EXPIRES_IN=7d
# CORS
CORS_ORIGIN=http://localhost:3000
# Frontend URL (for QR links etc.)
FRONTEND_URL=http://localhost:3000
# AI Provider (mock|groq) — mock is default for ₹0 dev, groq requires GROQ_API_KEY
AI_PROVIDER=mock
GROQ_API_KEY=
AI_MODEL=llama-3.1-8b-instant
AI_TIMEOUT_MS=10000
