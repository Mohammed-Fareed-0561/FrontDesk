// FrontDesk Prisma Schema — v0.1
// Local dev: SQLite (file:./dev.db) — zero infra. Production: switch provider to postgresql and update DATABASE_URL.
// This keeps the schema compatible with DATABASE-SCHEMA.md while remaining runnable without Docker.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Enums represented as TEXT in SQLite; validated via Zod/application layer
// Users & Workspaces
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String?  @map("display_name")
  avatarUrl    String?  @map("avatar_url")
  phone        String?
  status       String   @default("active") // active|invited|suspended
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  lastLoginAt  DateTime? @map("last_login_at")

  workspaceMembers WorkspaceMember[]
  ownedWorkspaces  Workspace[] @relation("WorkspaceOwner")
  businessesCreated Business[] @relation("BusinessCreator")
  auditLogs        AuditLog[]

  @@map("users")
}

model Workspace {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  ownerUserId String   @map("owner_user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  owner   User                @relation("WorkspaceOwner", fields: [ownerUserId], references: [id])
  members WorkspaceMember[]
  businesses Business[]
  invitations Invitation[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id")
  role        String   // owner|manager|staff
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model Invitation {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  email       String
  role        String
  tokenHash   String?   @map("token_hash")
  expiresAt   DateTime? @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("invitations")
}

// Business
model Business {
  id           String   @id @default(uuid())
  workspaceId  String   @map("workspace_id")
  name         String
  slug         String
  description  String?
  businessType String?  @map("business_type")
  industry     String?
  phone        String?
  email        String?
  websiteUrl   String?  @map("website_url")
  logoMediaId  String?  @map("logo_media_id")
  status       String   @default("active")
  timezone     String   @default("Asia/Kolkata")
  currency     String   @default("INR")
  locale       String   @default("en-IN")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  createdBy    String?  @map("created_by")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User?     @relation("BusinessCreator", fields: [createdBy], references: [id])

  locations  BusinessLocation[]
  hours      BusinessHours[]
  settings   BusinessSettings?
  categories Category[]
  products   Product[]
  services   Service[]
  offers     Offer[]
  websites   Website[]
  customers  Customer[]
  enquiries  Enquiry[]
  conversations Conversation[]
  importJobs ImportJob[]
  memories   BusinessMemory[]
  knowledgeDocuments KnowledgeDocument[]
  mediaAssets MediaAsset[]
  auditLogs  AuditLog[]
  domainEvents DomainEvent[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@map("businesses")
}

model BusinessLocation {
  id           String   @id @default(uuid())
  businessId   String   @map("business_id")
  name         String?
  addressLine1 String?  @map("address_line_1")
  addressLine2 String?  @map("address_line_2")
  city         String?
  state        String?
  postalCode   String?  @map("postal_code")
  country      String?  @default("IN")
  latitude     Float?
  longitude    Float?
  phone        String?
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("business_locations")
}

model BusinessHours {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  locationId String?  @map("location_id")
  dayOfWeek  Int      @map("day_of_week") // 0-6 Sun-Sat
  openTime   String?  @map("open_time") // "09:00"
  closeTime  String?  @map("close_time")
  isClosed   Boolean  @default(false) @map("is_closed")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("business_hours")
}

model BusinessSettings {
  id         String   @id @default(uuid())
  businessId String   @unique @map("business_id")
  settings   String   // JSON stringified
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_settings")
}

// Catalog
model Category {
  id          String   @id @default(uuid())
  businessId  String   @map("business_id")
  name        String
  description String?
  parentId    String?  @map("parent_id")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent   Category? @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")
  products Product[]

  @@index([businessId])
  @@map("categories")
}

model Product {
  id               String   @id @default(uuid())
  businessId       String   @map("business_id")
  categoryId       String?  @map("category_id")
  name             String
  slug             String
  description      String?
  shortDescription String?  @map("short_description")
  sku              String?
  price            Float?
  compareAtPrice   Float?   @map("compare_at_price")
  costPrice        Float?   @map("cost_price")
  currency         String   @default("INR")
  status           String   @default("draft") // draft|active|archived
  availability     String   @default("available") // available|unavailable|out_of_stock|coming_soon
  stockQuantity    Float?   @map("stock_quantity")
  trackInventory   Boolean  @default(false) @map("track_inventory")
  isFeatured       Boolean  @default(false) @map("is_featured")
  sortOrder        Int      @default(0) @map("sort_order")
  metadata         String?  // JSON
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants ProductVariant[]
  images   ProductImage[]
  orderItems OrderItem[]

  @@unique([businessId, slug])
  @@index([businessId, status])
  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  name          String
  sku           String?
  price         Float?
  costPrice     Float?   @map("cost_price")
  stockQuantity Float?   @map("stock_quantity")
  isActive      Boolean  @default(true) @map("is_active")
  metadata      String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  mediaId   String?  @map("media_id")
  url       String?
  altText   String?  @map("alt_text")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model Service {
  id              String   @id @default(uuid())
  businessId      String   @map("business_id")
  name            String
  slug            String
  description     String?
  price           Float?
  durationMinutes Int?     @map("duration_minutes")
  currency        String   @default("INR")
  status          String   @default("active")
  isFeatured      Boolean  @default(false) @map("is_featured")
  sortOrder       Int      @default(0) @map("sort_order")
  metadata        String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, slug])
  @@map("services")
}

model Offer {
  id                String    @id @default(uuid())
  businessId        String    @map("business_id")
  name              String
  code              String?
  description       String?
  discountType      String?   @map("discount_type") // percentage|fixed
  discountValue     Float?    @map("discount_value")
  minimumOrderValue Float?    @map("minimum_order_value")
  startsAt          DateTime? @map("starts_at")
  expiresAt         DateTime? @map("ends_at")
  usageLimit        Int?      @map("usage_limit")
  usageCount        Int       @default(0) @map("usage_count")
  status            String    @default("active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("offers")
}

// Website
model Website {
  id                 String   @id @default(uuid())
  businessId         String   @map("business_id")
  name               String?
  status             String   @default("draft") // draft|published
  draftVersionId     String?  @map("draft_version_id")
  publishedVersionId String?  @map("published_version_id")
  themeConfig        String?  @map("theme_config") // JSON
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  pages    WebsitePage[]
  versions WebsiteVersion[]
  domains  WebsiteDomain[]

  @@index([businessId])
  @@map("websites")
}

model WebsitePage {
  id        String   @id @default(uuid())
  websiteId String   @map("website_id")
  title     String
  slug      String
  pageType  String?  @map("page_type") // home|menu|about|contact etc
  status    String   @default("active")
  sortOrder Int      @default(0) @map("sort_order")
  seoConfig String?  @map("seo_config") // JSON
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  website  Website          @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  sections WebsiteSection[]

  @@unique([websiteId, slug])
  @@map("website_pages")
}

model WebsiteSection {
  id               String   @id @default(uuid())
  pageId           String   @map("page_id")
  sectionType      String   @map("section_type") // hero|products|about|gallery|contact|hours|map etc
  sortOrder        Int      @default(0) @map("sort_order")
  content          String   // JSON
  styleConfig      String?  @map("style_config") // JSON
  visibilityConfig String?  @map("visibility_config") // JSON
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  page WebsitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("website_sections")
}

model WebsiteVersion {
  id            String    @id @default(uuid())
  websiteId     String    @map("website_id")
  versionNumber Int       @map("version_number")
  snapshot      String    // JSON immutable
  createdBy     String?   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  publishedAt   DateTime? @map("published_at")

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, versionNumber])
  @@map("website_versions")
}

model WebsiteDomain {
  id                 String   @id @default(uuid())
  websiteId          String   @map("website_id")
  domain             String   @unique
  type               String?  // custom|subdomain
  verificationStatus String?  @map("verification_status")
  isPrimary          Boolean  @default(false) @map("is_primary")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@map("website_domains")
}

// Media
model MediaAsset {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  uploadedBy String?  @map("uploaded_by")
  fileName   String?  @map("file_name")
  storageKey String   @map("storage_key")
  mimeType   String?  @map("mime_type")
  fileSize   Int?     @map("file_size")
  width      Int?
  height     Int?
  altText    String?  @map("alt_text")
  status     String   @default("active")
  metadata   String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("media_assets")
}

// Import
model ImportJob {
  id              String    @id @default(uuid())
  businessId      String    @map("business_id")
  createdBy       String?   @map("created_by")
  sourceType      String    @map("source_type") // website|pdf|csv|image|manual
  sourceReference String?   @map("source_reference")
  status          String    @default("pending") // pending|processing|review_required|completed|failed|cancelled
  progress        Int       @default(0)
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  errorMessage    String?   @map("error_message")
  metadata        String?   // JSON
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sources  ImportSource[]
  items    ImportItem[]
  conflicts ImportConflict[]

  @@index([businessId, status])
  @@map("import_jobs")
}

model ImportSource {
  id             String   @id @default(uuid())
  importJobId    String   @map("import_job_id")
  sourceType     String   @map("source_type")
  sourceUrl      String?  @map("source_url")
  mediaId        String?  @map("media_id")
  sourceMetadata String?   @map("source_metadata") // JSON
  createdAt      DateTime @default(now()) @map("created_at")

  job ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@map("import_sources")
}

model ImportItem {
  id              String   @id @default(uuid())
  importJobId     String   @map("import_job_id")
  entityType      String   @map("entity_type") // product|category|business|hours etc
  entityData      String   @map("entity_data") // JSON
  confidenceScore Float?   @map("confidence_score")
  status          String   @default("pending") // pending|approved|rejected
  sourceReference String?   @map("source_reference")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  job ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@map("import_items")
}

model ImportConflict {
  id            String    @id @default(uuid())
  importJobId   String    @map("import_job_id")
  entityType    String    @map("entity_type")
  entityId      String?   @map("entity_id")
  existingValue String?   @map("existing_value") // JSON
  importedValue String?   @map("imported_value") // JSON
  resolution    String?   // keep_existing|use_imported|manual
  resolvedBy    String?   @map("resolved_by")
  resolvedAt    DateTime? @map("resolved_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  job ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@map("import_conflicts")
}

// Customers / Enquiries / Conversations
model Customer {
  id          String    @id @default(uuid())
  businessId  String    @map("business_id")
  name        String?
  email       String?
  phone       String?
  status      String    @default("active")
  source      String?
  firstSeenAt DateTime? @map("first_seen_at")
  lastSeenAt  DateTime? @map("last_seen_at")
  metadata    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  enquiries Enquiry[]
  conversations Conversation[]
  consents CustomerConsent[]

  @@index([businessId, phone])
  @@index([businessId, email])
  @@map("customers")
}

model CustomerConsent {
  id         String    @id @default(uuid())
  customerId String    @map("customer_id")
  consentType String   @map("consent_type") // marketing|notifications etc
  status     String    // granted|revoked
  source     String?
  grantedAt  DateTime? @map("granted_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_consents")
}

model Conversation {
  id            String    @id @default(uuid())
  businessId    String    @map("business_id")
  customerId    String?   @map("customer_id")
  channel       String    // website|whatsapp|email|manual
  status        String    @default("open") // open|waiting|resolved|archived
  assignedTo    String?   @map("assigned_to")
  lastMessageAt DateTime? @map("last_message_at")
  metadata      String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages Message[]
  enquiries Enquiry[]

  @@index([businessId, status])
  @@map("conversations")
}

model Message {
  id                String   @id @default(uuid())
  conversationId    String   @map("conversation_id")
  senderType        String   @map("sender_type") // customer|business|ai|system
  senderId          String?  @map("sender_id")
  content           String?
  messageType       String?  @map("message_type") // text|image|whatsapp_template
  externalMessageId String?  @map("external_message_id")
  metadata          String?
  createdAt         DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Enquiry {
  id             String    @id @default(uuid())
  businessId     String    @map("business_id")
  customerId     String?   @map("customer_id")
  conversationId String?   @map("conversation_id")
  subject        String?
  message        String?
  status         String    @default("new") // new|contacted|in_progress|waiting|resolved|closed
  priority       String?   // low|medium|high
  assignedTo     String?   @map("assigned_to")
  source         String?   // website|qr|whatsapp|manual
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  closedAt       DateTime? @map("closed_at")

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([businessId, status])
  @@map("enquiries")
}

// Orders (optional)
model Order {
  id            String    @id @default(uuid())
  businessId    String    @map("business_id")
  customerId    String?   @map("customer_id")
  orderNumber   String    @map("order_number")
  status        String    @default("pending")
  paymentStatus String?   @map("payment_status")
  currency      String    @default("INR")
  subtotal      Float?
  discountAmount Float?   @map("discount_amount")
  taxAmount     Float?    @map("tax_amount")
  deliveryAmount Float?   @map("delivery_amount")
  totalAmount   Float?    @map("total_amount")
  notes         String?
  source        String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  cancelledAt   DateTime? @map("cancelled_at")
  completedAt   DateTime? @map("completed_at")

  items OrderItem[]

  @@unique([businessId, orderNumber])
  @@index([businessId, status])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String   @map("order_id")
  productId      String?  @map("product_id")
  variantId      String?  @map("variant_id")
  nameSnapshot   String   @map("name_snapshot")
  unitPrice      Float?   @map("unit_price")
  quantity       Float
  discountAmount Float?   @map("discount_amount")
  taxAmount      Float?   @map("tax_amount")
  totalAmount    Float?   @map("total_amount")
  metadata       String?
  createdAt      DateTime @default(now()) @map("created_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

// Knowledge / Memory
model KnowledgeDocument {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  sourceType String?  @map("source_type")
  sourceId   String?  @map("source_id")
  title      String?
  content    String?
  status     String   @default("active")
  metadata   String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  chunks   KnowledgeChunk[]

  @@index([businessId])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  chunkIndex Int?     @map("chunk_index")
  content    String
  embedding  String?  // JSON array string for SQLite dev; vector in Postgres
  metadata   String?
  createdAt  DateTime @default(now()) @map("created_at")

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("knowledge_chunks")
}

model BusinessMemory {
  id         String    @id @default(uuid())
  businessId String    @map("business_id")
  key        String?
  content    String
  memoryType String?   @map("memory_type") // brand_preference etc
  importance Int?      // 1-5
  confidence Float?
  source     String?   // owner|ai|import
  status     String    @default("active") // suggested|active|archived
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  events   MemoryEvent[]

  @@index([businessId])
  @@map("business_memories")
}

model MemoryEvent {
  id        String   @id @default(uuid())
  memoryId  String   @map("memory_id")
  eventType String   @map("event_type") // created|updated|archived
  oldValue  String?  @map("old_value")
  newValue  String?  @map("new_value")
  actorType String?  @map("actor_type")
  actorId   String?  @map("actor_id")
  createdAt DateTime @default(now()) @map("created_at")

  memory BusinessMemory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@map("memory_events")
}

// AI / Actions / Automations / Events / Audit
model AiRequest {
  id            String    @id @default(uuid())
  businessId    String?   @map("business_id")
  userId        String?   @map("user_id")
  agentId       String?   @map("agent_id")
  requestType   String?   @map("request_type")
  modelProvider String?   @map("model_provider")
  modelName     String?   @map("model_name")
  status        String    @default("pending")
  inputTokens   Int?      @map("input_tokens")
  outputTokens  Int?      @map("output_tokens")
  latencyMs     Int?      @map("latency_ms")
  createdAt     DateTime @default(now()) @map("created_at")
  completedAt   DateTime? @map("completed_at")

  outputs AiOutput[]

  @@index([businessId])
  @@map("ai_requests")
}

model AiOutput {
  id          String   @id @default(uuid())
  aiRequestId String   @map("ai_request_id")
  outputType  String?  @map("output_type")
  content     String   // JSON
  confidence  Float?
  createdAt   DateTime @default(now()) @map("created_at")

  request AiRequest @relation(fields: [aiRequestId], references: [id], onDelete: Cascade)

  @@map("ai_outputs")
}

model ActionDefinition {
  id               String   @id @default(uuid())
  actionKey        String   @unique @map("action_key")
  name             String
  description      String?
  inputSchema      String?  @map("input_schema") // JSON
  permissionScope  String?  @map("permission_scope")
  approvalRequired Boolean  @default(false) @map("approval_required")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("action_definitions")
}

model ActionExecution {
  id                 String    @id @default(uuid())
  businessId         String    @map("business_id")
  actionDefinitionId String    @map("action_definition_id")
  requestedByType    String?   @map("requested_by_type") // user|ai|system
  requestedById      String?   @map("requested_by_id")
  status             String    @default("pending") // pending|approved|executing|completed|failed|cancelled
  inputPayload       String?   @map("input_payload") // JSON
  resultPayload      String?   @map("result_payload")
  errorMessage       String?   @map("error_message")
  approvalRequestId  String?   @map("approval_request_id")
  createdAt          DateTime @default(now()) @map("created_at")
  startedAt          DateTime? @map("started_at")
  completedAt        DateTime? @map("completed_at")

  @@index([businessId, status])
  @@map("action_executions")
}

model ApprovalRequest {
  id                String    @id @default(uuid())
  businessId        String    @map("business_id")
  actionExecutionId String?   @map("action_execution_id")
  requestedByType   String?   @map("requested_by_type")
  requestedById     String?   @map("requested_by_id")
  status            String    @default("pending") // pending|approved|rejected|expired
  reason            String?
  reviewedBy        String?   @map("reviewed_by")
  reviewedAt        DateTime? @map("reviewed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  expiresAt         DateTime? @map("expires_at")

  @@index([businessId, status])
  @@map("approval_requests")
}

model Automation {
  id              String   @id @default(uuid())
  businessId      String   @map("business_id")
  name            String
  description     String?
  status          String   @default("active") // active|inactive|draft
  triggerConfig   String?  @map("trigger_config") // JSON
  conditionsConfig String? @map("conditions_config")
  actionsConfig   String?   @map("actions_config")
  createdBy       String?   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  steps AutomationStep[]
  runs  AutomationRun[]

  @@index([businessId])
  @@map("automations")
}

model AutomationStep {
  id            String   @id @default(uuid())
  automationId  String   @map("automation_id")
  stepOrder     Int      @map("step_order")
  stepType      String   @map("step_type")
  configuration String?  // JSON
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@map("automation_steps")
}

model AutomationRun {
  id               String    @id @default(uuid())
  automationId     String    @map("automation_id")
  triggerEventId   String?   @map("trigger_event_id")
  status           String    @default("pending")
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  errorMessage     String?
  executionContext String?   @map("execution_context") // JSON
  createdAt        DateTime  @default(now()) @map("created_at")

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@map("automation_runs")
}

model DomainEvent {
  id            String    @id @default(uuid())
  businessId    String?   @map("business_id")
  eventType     String    @map("event_type")
  aggregateType String?   @map("aggregate_type")
  aggregateId   String?   @map("aggregate_id")
  payload       String    // JSON
  occurredAt    DateTime  @default(now()) @map("occurred_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  processedAt   DateTime? @map("processed_at")

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  deliveries EventDelivery[]

  @@index([businessId, eventType])
  @@map("domain_events")
}

model EventDelivery {
  id            String    @id @default(uuid())
  eventId       String    @map("event_id")
  consumer      String
  status        String    @default("pending")
  attemptCount  Int       @default(0) @map("attempt_count")
  lastAttemptAt DateTime? @map("last_attempt_at")
  processedAt   DateTime? @map("processed_at")
  errorMessage  String?   @map("error_message")
  createdAt     DateTime  @default(now()) @map("created_at")

  event DomainEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_deliveries")
}

model AuditLog {
  id         String   @id @default(uuid())
  businessId String?  @map("business_id")
  actorType  String   @map("actor_type") // user|ai|system
  actorId    String?  @map("actor_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  beforeData String?  @map("before_data") // JSON
  afterData  String?  @map("after_data") // JSON
  metadata   String?
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at")

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [actorId], references: [id])

  @@index([businessId, createdAt])
  @@map("audit_logs")
}
